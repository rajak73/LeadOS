{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Every setting the API and the scripts read, so `VAR=… pnpm dev|test|db:*` reaches them.
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "PGUSER",
    "TEST_DATABASE_URL",
    "LEGACY_DATABASE_URL",
    "JWT_SECRET",
    "APP_ORIGIN",
    "PUBLIC_URL",
    "TRUST_PROXY",
    "ENCRYPTION_KEY",
    "BCRYPT_COST",
    "LOG_LEVEL",
    "WEB_DIST_DIR",
    "AI_PROVIDER",
    "AI_MODEL",
    "GEMINI_API_KEY",
    "GROQ_API_KEY",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "INSTAGRAM_TEST_MODE",
    "INSTAGRAM_GRAPH_VERSION",
    "INSTAGRAM_ACCESS_TOKEN",
    "INSTAGRAM_APP_ID",
    "INSTAGRAM_APP_SECRET",
    "INSTAGRAM_OAUTH_REDIRECT_URI",
    "INSTAGRAM_WEBHOOK_VERIFY_TOKEN",
    "META_APP_SECRET",
    "META_WEBHOOK_VERIFY_TOKEN",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_PASSWORD",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
