// LeadOS — single-organisation CRM on SQLite.
//
// SQLite notes:
// - No native enums: enum-like columns are String and validated by the zod schemas in
//   packages/shared (constants/enums.ts is the single source of allowed values).
// - No scalar lists: `tags` is a Json array of strings.
// - `contains` filters are case-insensitive for ASCII (SQLite LIKE); `mode: 'insensitive'`
//   is not supported and must not be used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Settings ────────────────────────────────────────────────────────────────

// Single row (id = 1) holding company-wide settings.
model AppSettings {
  id              Int      @id // always 1 (upserted by the app)
  companyName     String   @default("My Company")
  defaultCurrency String   @default("INR")
  timezone        String   @default("Asia/Kolkata")
  aiScoringAuto   Boolean  @default(true) // rescore leads automatically on create/update
  updatedAt       DateTime @updatedAt
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String    @default("")
  role             String    @default("MEMBER") // UserRole: ADMIN | MEMBER
  status           String    @default("ACTIVE") // UserStatus: ACTIVE | DISABLED
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  assignedLeads    Lead[]         @relation("LeadAssignee")
  createdLeads     Lead[]         @relation("LeadCreator")
  assignedContacts Contact[]      @relation("ContactAssignee")
  createdContacts  Contact[]      @relation("ContactCreator")
  assignedDeals    Deal[]         @relation("DealAssignee")
  createdDeals     Deal[]         @relation("DealCreator")
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskCreator")
  notes            Note[]
  activities       Activity[]
  notifications    Notification[]
  createdWorkflows Workflow[]
}

// Opaque refresh tokens, stored hashed. Rotated on use; reuse of a used token revokes
// the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id                   String    @id @default(uuid())
  firstName            String
  lastName             String?
  email                String?
  phone                String?
  company              String?
  source               String    @default("MANUAL") // LeadSource
  status               String    @default("NEW") // LeadStatus
  tags                 Json      @default("[]") // string[]
  lostReason           String?
  aiScore              Int?
  aiScoreUpdatedAt     DateTime?
  assignedToId         String?
  createdById          String
  convertedToContactId String?
  lastActivityAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  assignedTo         User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User       @relation("LeadCreator", fields: [createdById], references: [id])
  convertedToContact Contact?   @relation("LeadToContact", fields: [convertedToContactId], references: [id], onDelete: SetNull)
  deals              Deal[]
  tasks              Task[]
  notes              Note[]
  activities         Activity[]
  aiScores           AiScore[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([aiScore])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([email])
  @@index([deletedAt])
}

model Contact {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  company        String?
  jobTitle       String?
  tags           Json      @default("[]") // string[]
  assignedToId   String?
  createdById    String
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  assignedTo     User?      @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User       @relation("ContactCreator", fields: [createdById], references: [id])
  convertedLeads Lead[]     @relation("LeadToContact")
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]

  @@index([email])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Pipeline {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]
}

// Ordered by `order` ASC. Each pipeline has exactly one isWon and one isLost stage
// (enforced in the service layer).
model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  order       Int
  color       String? // #RRGGBB
  probability Int? // 0–100
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  value             Float?
  currency          String    @default("INR")
  status            String    @default("OPEN") // DealStatus
  pipelineId        String
  stageId           String
  leadId            String?
  contactId         String?
  assignedToId      String?
  createdById       String
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead       Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User          @relation("DealCreator", fields: [createdById], references: [id])
  tasks      Task[]
  notes      Note[]
  activities Activity[]

  @@index([pipelineId, stageId, status])
  @@index([leadId])
  @@index([contactId])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  type             String    @default("OTHER") // TaskType
  priority         String    @default("MEDIUM") // TaskPriority
  status           String    @default("PENDING") // TaskStatus
  dueDate          DateTime?
  completedAt      DateTime?
  reminderSentAt   DateTime?
  assignedToId     String?
  createdById      String
  relatedLeadId    String?
  relatedContactId String?
  relatedDealId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  assignedTo     User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User     @relation("TaskCreator", fields: [createdById], references: [id])
  relatedLead    Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedContact Contact? @relation(fields: [relatedContactId], references: [id], onDelete: SetNull)
  relatedDeal    Deal?    @relation(fields: [relatedDealId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status])
  @@index([dueDate, status])
  @@index([relatedLeadId])
  @@index([relatedDealId])
  @@index([deletedAt])
}

// Plain-text notes.
model Note {
  id               String    @id @default(uuid())
  content          String
  createdById      String
  relatedLeadId    String?
  relatedContactId String?
  relatedDealId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  createdBy      User     @relation(fields: [createdById], references: [id])
  relatedLead    Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedContact Contact? @relation(fields: [relatedContactId], references: [id], onDelete: Cascade)
  relatedDeal    Deal?    @relation(fields: [relatedDealId], references: [id], onDelete: Cascade)

  @@index([relatedLeadId])
  @@index([relatedContactId])
  @@index([relatedDealId])
}

// Append-only timeline.
model Activity {
  id               String   @id @default(uuid())
  type             String // ActivityType
  description      String
  metadata         Json     @default("{}")
  performedById    String? // null = system / workflow
  relatedLeadId    String?
  relatedContactId String?
  relatedDealId    String?
  createdAt        DateTime @default(now())

  performedBy    User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)
  relatedLead    Lead?    @relation(fields: [relatedLeadId], references: [id], onDelete: Cascade)
  relatedContact Contact? @relation(fields: [relatedContactId], references: [id], onDelete: Cascade)
  relatedDeal    Deal?    @relation(fields: [relatedDealId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([relatedLeadId, createdAt])
  @@index([relatedContactId, createdAt])
  @@index([relatedDealId, createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String // NotificationType
  title      String
  body       String
  entityType String? // 'lead' | 'deal' | 'task' | 'contact'
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ─── AI ──────────────────────────────────────────────────────────────────────

// Full scoring history; Lead.aiScore is the denormalised latest value.
model AiScore {
  id             String   @id @default(uuid())
  leadId         String
  score          Int
  factors        Json     @default("[]") // ScoringFactor[]
  recommendation String
  modelVersion   String
  triggeredBy    String // 'manual' | 'auto' | 'workflow'
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ─── Automation ──────────────────────────────────────────────────────────────

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  triggerType String // WorkflowTriggerType
  definition  Json // WorkflowDefinition (validated by zod)
  isActive    Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User          @relation(fields: [createdById], references: [id])
  runs      WorkflowRun[]

  @@index([triggerType, isActive])
}

model WorkflowRun {
  id           String    @id @default(uuid())
  workflowId   String
  status       String    @default("PENDING") // WorkflowRunStatus
  triggerEvent Json // { type, entityId, payload }
  actionLogs   Json      @default("[]") // ActionLog[]
  error        String?
  depth        Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
}
